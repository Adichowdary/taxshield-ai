# Server Configuration
PORT=5000

# MongoDB Database Architecture
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/taxshield?retryWrites=true&w=majority

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=ujdskwps
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication & JWT
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend API URL (optional override, defaults to /api via Vite proxy)
VITE_API_BASE_URL=/api

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyFromFirebaseConsole

# LLM Provider Configuration
VITE_ACTIVE_LLM_PROVIDER=custom # custom | gemini | claude
VITE_LLM_FALLBACK_ENABLED=true

# TaxShield AI (Custom Self-Hosted Local GPU LLM - Ollama / vLLM)
VITE_CUSTOM_LLM_ENDPOINT=http://localhost:11434/v1
VITE_CUSTOM_LLM_MODEL=llama3:8b
VITE_CUSTOM_LLM_API_KEY=

# Google Gemini API
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude API
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key
VITE_CLAUDE_MODEL=claude-3-5-haiku-20241022

# NVIDIA Nemotron-3 Ultra API
VITE_NVIDIA_API_KEY=your_nvidia_api_key
VITE_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
